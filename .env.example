# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Google Sheets API Credentials
# Service Account의 client_email
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service Account의 private_key (JSON 파일에서 복사)
# 주의: \n을 그대로 포함해서 복사하세요
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Spreadsheet ID
# 스프레드시트 URL에서 추출: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet Range (기본값: Sheet1!A:Z)
# 예: Sheet1!A1:E100, 시트이름!A:Z
GOOGLE_SHEET_RANGE=Sheet1!A:Z